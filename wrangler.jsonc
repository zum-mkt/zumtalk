{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zumtalk-site",
  "account_id": "038360028859e142fb2dd18145ced1cf",
  "compatibility_date": "2026-10-05",
  "main": "worker/index.ts",
  // Mantém o endereço zumtalk-site...workers.dev como reserva.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // O Worker só roda nestas rotas; JS, CSS e imagens vão direto do cache do Cloudflare.
    "run_worker_first": ["/api/*", "/", "/planos", "/planos/", "/admin", "/admin/*", "/blog", "/blog/*", "/media/*", "/sitemap.xml"]
  },
  // Domínios do site. O Cloudflare cria o DNS e o certificado sozinho; www redireciona para o domínio principal.
  "routes": [
    { "pattern": "zumtalk.com", "custom_domain": true },
    { "pattern": "www.zumtalk.com", "custom_domain": true }
  ],
  // Login do painel /admin. A senha fica no segredo ADMIN_PASSWORD (npx wrangler secret put ADMIN_PASSWORD).
  "vars": { "ADMIN_EMAIL": "zum@agenciazum.com.br" },
  // Conteúdo e blog editados no painel /admin.
  "kv_namespaces": [{ "binding": "CONTENT", "id": "157539242c1a4e1abe4a1418527d4b46" }]
}
